{
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.0",
    "handlebars": "^4.7.7",
    "mongodb": "^4.5.0",
    "mongoose": "^7.1.0",
    "npm": "^9.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "scripts": {
    "dev": "docker compose up -d",
    "dev:build": "docker compose up --build",
    "down": "docker compose down",
    "down:clean": "docker compose down -v",
    "logs": "docker compose logs -f backend",
    "start": "node index.js",
    "dev:container": "nodemon index.js",
    "seed:users": "node scripts/seedRequiredUsers.js",
    "assign:museum-role": "node scripts/assignMuseumRole.js",
    "migrate:semantic-model": "node scripts/migrateSemanticModel.js",
    "check": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.js"
  }
}
