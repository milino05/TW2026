MONGO_URI=mongodb://mongo:27017/artaround?replicaSet=rs0
PORT=8000
NODE_ENV=development

# Resolver DNS raggiungibile dai container, usato per Wikidata e gli altri provider esterni.
# Se la rete usa un resolver aziendale o locale, sostituire questo valore nella propria .env.
DOCKER_DNS=1.1.1.1

# Origini frontend separate da virgole, per esempio:
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ORIGINS=

# Default: 168 ore (7 giorni)
SESSION_DURATION_HOURS=168

# In produzione viene abilitato automaticamente da NODE_ENV=production.
SESSION_COOKIE_SECURE=false

# Segreto stabile usato esclusivamente per pseudonimizzare i contributor dei modelli
# collettivi con HMAC-SHA256. Usare un valore casuale lungo e NON cambiarlo durante
# il ciclo di vita del database, altrimenti non sara piu possibile riconoscere/rimuovere
# i contributi pseudonimi gia creati dallo stesso utente.
ADAPTIVE_CONTRIBUTOR_SECRET=replace-with-a-long-random-secret

# Semantic Resolver: le chiamate al provider partono solo dal backend.
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIMEDIA_COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
WIKIDATA_USER_AGENT=ArtAroundTW2026/1.0 (https://github.com/milino05/TW2026)
SEMANTIC_RESOLVER_TIMEOUT_MS=5000
SEMANTIC_RESOLVER_RETRY_COUNT=1
SEMANTIC_RESOLVER_RETRY_BASE_MS=300
SEMANTIC_RESOLVER_MAX_AUTO_RETRY_AFTER_MS=2000
SEMANTIC_RESOLVER_CACHE_MAX_ENTRIES=300
SEMANTIC_RESOLVER_SEARCH_CACHE_TTL_MS=120000
SEMANTIC_RESOLVER_RESOLVE_CACHE_TTL_MS=600000

# Directory radice con navigator-platform/ e navigator-configs/<venueId>/.
# Vuoto: usa le configurazioni multi-museo incluse nella build del client.
NAVIGATOR_CONFIG_DIR=

# Storage persistente degli asset caricati. Il docker-compose predefinito monta
# volumi separati per contenuti editoriali, planimetrie e media fisici di riconoscimento.
ITEM_MEDIA_DIR=/app/uploads/item-media
VENUE_FLOOR_PLAN_DIR=/app/uploads/venue-floor-plans
VENUE_RECOGNITION_MEDIA_DIR=/app/uploads/venue-recognition-media
